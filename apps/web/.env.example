# Required.
ROOMS_BASE_URL=http://127.0.0.1:8787
NEXT_PUBLIC_ROOMS_BASE_URL=http://127.0.0.1:8787
AUTH_SECRET=

# Optional. Each unset value degrades exactly one feature; see README.md.
# Postgres: settlement archive, leaderboard, and replay.
DATABASE_URL=
# GitHub sign-in. Guests can bid without it.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Post-settlement commentary (/api/bot). With neither key set, the room
# renders no commentary and the auction is otherwise unaffected.
# LLM_PROVIDER forces one: "gemini" | "anthropic". Left empty, whichever
# key is present is used, preferring ANTHROPIC_API_KEY if both are.
LLM_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
